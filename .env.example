# Discord Bot Token (Obter em: https://discord.com/developers/applications -> Bot -> Reset Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Groq API Key (Obter em: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Nomes adicionais opcionais (agora pode usar /voicenoted addword dentro do Discord)
CUSTOM_NAMES=

# Ativar sincronização total de membros (Requer 'Server Members Intent' ativado no Discord Developer Portal)
ENABLE_MEMBERS_INTENT=false
